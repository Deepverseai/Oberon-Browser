<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/obsidian_base"
    android:orientation="vertical">

    <!-- Top Navigation Toolbar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/obsidian_base"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="8dp">

        <!-- Embedded Smart Omnibox -->
        <include
            android:id="@+id/layoutOmnibox"
            layout="@layout/layout_omnibox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Tab Count Badge Button -->
        <FrameLayout
            android:id="@+id/btnTabSwitcher"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvTabCountBadge"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_tab_badge"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Overflow Menu (3-dots) -->
        <ImageButton
            android:id="@+id/btnOverflowMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@android:drawable/ic_menu_more"
            android:tint="@color/text_secondary"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <!-- Page Loading Progress Bar -->
    <ProgressBar
        android:id="@+id/pbLoading"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="false"
        android:max="100"
        android:progressBackgroundTint="@color/charcoal_surface"
        android:progressTint="@color/accent_sage"
        android:visibility="gone" />

    <!-- Main Content Area: Pull to Refresh + Web Container -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/obsidian_base">

            <!-- Speed Dial Homepage View Container -->
            <FrameLayout
                android:id="@+id/homeContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Bottom Navigation Bar for quick thumb access -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/charcoal_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnNavBack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_media_previous"
            android:tint="@color/text_secondary"
            tools:ignore="UseAppTint" />

        <!-- Forward Button -->
        <ImageButton
            android:id="@+id/btnNavForward"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Forward"
            android:src="@android:drawable/ic_media_next"
            android:tint="@color/text_secondary"
            tools:ignore="UseAppTint" />

        <!-- Home Button -->
        <ImageButton
            android:id="@+id/btnNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:src="@android:drawable/ic_menu_today"
            android:tint="@color/text_secondary"
            tools:ignore="UseAppTint" />

        <!-- Dual Preview Mode Switcher (Web / App) -->
        <ImageButton
            android:id="@+id/btnPreviewMode"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Preview Mode"
            android:src="@android:drawable/ic_menu_slideshow"
            android:tint="@color/accent_sage"
            tools:ignore="UseAppTint" />

        <!-- Stop / Reload Button -->
        <ImageButton
            android:id="@+id/btnNavReload"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Reload"
            android:src="@android:drawable/ic_menu_rotate"
            android:tint="@color/text_secondary"
            tools:ignore="UseAppTint" />
    </LinearLayout>

</LinearLayout>
