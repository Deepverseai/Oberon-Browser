<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/omniboxContainer"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_omnibox"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp">

    <!-- SSL Padlock / Site Security Indicator -->
    <ImageView
        android:id="@+id/ivSslStatus"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="@string/ssl_secure"
        android:src="@android:drawable/ic_secure"
        android:tint="@color/accent_sage"
        tools:ignore="UseAppTint" />

    <!-- Smart Autocomplete Input -->
    <AutoCompleteTextView
        android:id="@+id/omniboxInput"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@null"
        android:completionThreshold="1"
        android:dropDownBackgroundTint="@color/charcoal_surface"
        android:hint="@string/search_hint"
        android:imeOptions="actionGo|flagNoExtractUi"
        android:inputType="textUri|textAutoComplete"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Clear Query Button (X) -->
    <ImageButton
        android:id="@+id/btnClearQuery"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Clear search"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@color/text_secondary"
        android:visibility="gone"
        tools:ignore="UseAppTint" />

    <!-- Voice Search Microphone Button -->
    <ImageButton
        android:id="@+id/btnVoiceSearch"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Voice Search"
        android:src="@android:drawable/ic_btn_speak_now"
        android:tint="@color/text_secondary"
        tools:ignore="UseAppTint" />

</LinearLayout>
